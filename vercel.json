{
  "version": 2,
  "builds": [
    {
      "src": "boutique_management/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "build_vercel.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "boutique_management/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "boutique_management.settings"
  }
}
